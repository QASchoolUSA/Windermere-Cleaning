{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": "worker.ts",
	"name": "windermere-cleaning",
	"compatibility_date": "2026-07-15",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "windermere-cleaning"
		}
	],
	"images": {
		"binding": "IMAGES"
	},
	"observability": {
		"enabled": true
	},
	"triggers": {
		"crons": [
			"*/5 * * * *"
		]
	},
	"kv_namespaces": [
		{
			// Create KV in the same Cloudflare account as Workers Builds, then paste the id.
			// CF namespace title suggestion: BOOKING_OUTBOX_WINDERMERE
			"binding": "BOOKING_OUTBOX",
			"id": "REPLACE_WITH_BOOKING_OUTBOX_KV_ID"
		}
	],
	"vars": {
		"NEXT_PUBLIC_SITE_URL": "https://windermerecleaning.com",
		"BOOKING_BROOM_MODE": "live"
	}
}
