{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": "worker.ts",
	"name": "windermere-cleaning",
	"compatibility_date": "2026-07-15",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "windermere-cleaning"
		}
	],
	"images": {
		"binding": "IMAGES"
	},
	"observability": {
		"enabled": true
	},
	"triggers": {
		"crons": [
			"*/5 * * * *"
		]
	},
	"kv_namespaces": [
		{
			// CF namespace title: BOOKING_OUTBOX_WINDERMERE
			"binding": "BOOKING_OUTBOX",
			"id": "d3a3066b477149aaa3e91985d7a461df"
		}
	],
	"vars": {
		"NEXT_PUBLIC_SITE_URL": "https://windermerecleaning.com",
		"BOOKING_BROOM_MODE": "live"
	},
	"routes": [
		{
			"pattern": "windermerecleaning.com",
			"custom_domain": true
		}
	]
}
